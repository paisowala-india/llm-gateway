{
  "port": 8888,
  "host": "127.0.0.1",
  "providers": {
    "openai": {
      "baseUrl": "https://api.openai.com",
      "basePath": "/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "models": {
        "gpt-4o": { "max": 5, "name": "GPT-4o" },
        "gpt-4o-mini": { "max": 30, "name": "GPT-4o Mini" },
        "gpt-4-turbo": { "max": 10, "name": "GPT-4 Turbo" },
        "gpt-3.5-turbo": { "max": 50, "name": "GPT-3.5 Turbo" }
      }
    }
  },
  "fallbackTimeoutMs": 60000,
  "primaryModel": "gpt-4o",
  "fallbackModels": ["gpt-4o-mini", "gpt-4-turbo", "gpt-3.5-turbo"]
}