{
  "name": "llm-gateway",
  "version": "1.0.0",
  "description": "Lightweight LLM gateway with automatic fallback, rate limiting, and multi-provider routing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "status": "curl -s http://127.0.0.1:8888/gateway-status | jq '.'",
    "logs": "tail -f logs/proxy.log"
  },
